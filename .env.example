# Token from @BotFather
BOT_TOKEN=

# Telegram user id of the Owner actor
OWNER_ID=

# Telegram user id of the Executor actor
EXECUTOR_ID=

# Telegram chat id of the shared group chat (bot must be a member/admin there).
# Negative number for a normal group, e.g. -1001234567890 for a supergroup.
GROUP_CHAT_ID=

# Path to the sqlite database file (inside the container this is /app/data/bot.db)
DB_PATH=data/bot.db

# Optional: proxy to reach api.telegram.org, only needed if your ISP/host blocks Telegram directly.
# Supports http://, https://, socks4://, socks5:// — e.g. socks5://user:pass@1.2.3.4:1080
# Leave empty when deploying somewhere that can already reach Telegram directly.
PROXY_URL=
